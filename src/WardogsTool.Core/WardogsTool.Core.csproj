<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game-independent logic. No Windows or WPF dependency: everything here runs in plain unit tests. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>WardogsTool.Core</RootNamespace>
  </PropertyGroup>

  <!-- Settings use the built-in DataContractJsonSerializer: no NuGet dependencies to ship. -->
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WardogsTool.Core.Tests" />
  </ItemGroup>

</Project>
