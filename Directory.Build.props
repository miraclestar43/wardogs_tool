<Project>

  <!-- Shared by every project in the repo. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Pin PlatformTarget only; do not declare Platforms. Declaring Platforms makes building the
      project and building the solution write to different folders (bin/Debug vs bin/x64/Debug).
    -->
    <PlatformTarget>x64</PlatformTarget>
    <Product>WardogsTool</Product>
    <Company>WardogsTool</Company>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

</Project>
